---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const selectedCategoryIds = Astro.url.searchParams
    .getAll('category')
    .map((value) => Number(value))
    .filter((value) => Number.isInteger(value) && value > 0);
const selectedPublisherIds = Astro.url.searchParams
    .getAll('publisher')
    .map((value) => Number(value))
    .filter((value) => Number.isInteger(value) && value > 0);
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
const hasActiveFilters = selectedCategoryIds.length > 0 || selectedPublisherIds.length > 0;
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-900/60 p-6 shadow-lg" data-testid="game-filters-panel">
      <form method="get" action="/" class="space-y-6" data-testid="game-filters-form">
        <div class="grid gap-6 md:grid-cols-2">
          <fieldset class="space-y-3">
            <legend class="text-lg font-semibold text-slate-100">Filter by category</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500/60 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none" data-testid={`category-filter-${category.id}`}>
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    checked={selectedCategoryIds.includes(category.id)}
                    class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-blue-500"
                    data-testid={`category-checkbox-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="space-y-3">
            <legend class="text-lg font-semibold text-slate-100">Filter by publisher</legend>
            <div class="flex flex-wrap gap-3">
              {publishers.map((publisher) => (
                <label class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-purple-500/60 focus-within:ring-2 focus-within:ring-purple-500 focus-within:outline-none" data-testid={`publisher-filter-${publisher.id}`}>
                  <input
                    type="checkbox"
                    name="publisher"
                    value={publisher.id}
                    checked={selectedPublisherIds.includes(publisher.id)}
                    class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-purple-500 focus:ring-purple-500"
                    data-testid={`publisher-checkbox-${publisher.id}`}
                  />
                  <span>{publisher.name}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            class="rounded-lg bg-blue-700 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-700 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-testid="apply-filters-button"
          >
            Apply filters
          </button>

          <a
            href="/"
            class:list={['rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:border-slate-500 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500', { hidden: !hasActiveFilters }]}
            data-testid="clear-filters-link"
          >
            Clear filters
          </a>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    (() => {
      const form = document.querySelector('[data-testid="game-filters-form"]') as HTMLFormElement | null;
      const cards = Array.from(document.querySelectorAll('[data-testid="game-card"]')) as HTMLElement[];
      const grid = document.querySelector('[data-testid="games-grid"]') as HTMLElement | null;
      const emptyState = document.querySelector('[data-testid="filter-empty-state"]') as HTMLElement | null;
      const clearFiltersLink = document.querySelector('[data-testid="clear-filters-link"]') as HTMLAnchorElement | null;

      if (!form || !grid || cards.length === 0) {
        return;
      }

      const getSelectedValues = (name: string) =>
        Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((input) => Number(input.value));

      const applyFilters = () => {
        const selectedCategories = getSelectedValues('category');
        const selectedPublishers = getSelectedValues('publisher');
        let visibleCount = 0;

        if (clearFiltersLink) {
          clearFiltersLink.classList.toggle('hidden', selectedCategories.length === 0 && selectedPublishers.length === 0);
        }

        cards.forEach((card) => {
          const categoryId = Number(card.dataset.gameCategoryId || 0);
          const publisherId = Number(card.dataset.gamePublisherId || 0);
          const matchesCategory =
            selectedCategories.length === 0 || selectedCategories.includes(categoryId);
          const matchesPublisher =
            selectedPublishers.length === 0 || selectedPublishers.includes(publisherId);
          const isVisible = matchesCategory && matchesPublisher;

          card.hidden = !isVisible;
          if (isVisible) {
            visibleCount += 1;
          }
        });

        const hasVisibleCards = visibleCount > 0;
        grid.classList.toggle('hidden', !hasVisibleCards);
        if (emptyState) {
          emptyState.classList.toggle('hidden', hasVisibleCards);
        }
      };

      const syncUrl = () => {
        const selectedCategories = getSelectedValues('category');
        const selectedPublishers = getSelectedValues('publisher');
        const params = new URLSearchParams();

        selectedCategories.forEach((id) => params.append('category', String(id)));
        selectedPublishers.forEach((id) => params.append('publisher', String(id)));

        const nextUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
        window.history.replaceState({}, '', nextUrl);
      };

      const applySelectionFromUrl = () => {
        const params = new URLSearchParams(window.location.search);
        const selectedCategories = params.getAll('category');
        const selectedPublishers = params.getAll('publisher');

        form.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
          input.checked = selectedCategories.includes(input.value);
        });

        form.querySelectorAll<HTMLInputElement>('input[name="publisher"]').forEach((input) => {
          input.checked = selectedPublishers.includes(input.value);
        });

        applyFilters();
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        syncUrl();
        applyFilters();
      });

      applySelectionFromUrl();
    })();
  </script>
</Layout>
